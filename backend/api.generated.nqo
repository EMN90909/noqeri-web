// Checked-in bootstrap artifact. CI and Docker regenerate this from backend/api.nqr with `noqeri web`.
const __host=()=>globalThis.NoqeriHost
const httpStatic=(a,b)=>__host().httpStatic(a,b)
const dbOpen=(p)=>__host().dbOpen(p)
const dbExec=(h,s)=>__host().dbExec(h,s)
export function apiStatus(){return 'ok'}
export function apiLanguage(){return '1.0'}
export function apiEdition(){return '2026'}
export function apiCompiler(){return '1.0.0'}
export function apiRegistry(){return 'https://github.com/EMN90909/noqeri-registry'}
export function apiSource(){return 'Noqeri'}
export function configureServer(){return httpStatic('/','dist')}
export function serverCanHandle(method,path){return path==='/api/health'||path==='/api/meta'||path==='/api/db-demo'}
export function serverStatus(method,path){return serverCanHandle(method,path)?200:404}
export function serverContentType(method,path){return path==='/api/db-demo'?'text/plain; charset=utf-8':'application/json; charset=utf-8'}
export function databaseDemo(){const h=dbOpen('site-demo.nqdb');return dbExec(h,'table health { key: text key, value: text required }; delete health; insert health { key: "status", value: "ok" }; select health where key = "status"')}
export function serverHandle(method,path){if(path==='/api/health')return '{"status":"ok","language":"1.0","source":"Noqeri"}';if(path==='/api/meta')return '{"language":"1.0","edition":"2026","compiler":"1.0.0"}';if(path==='/api/db-demo')return databaseDemo();return '{"error":"not_found"}'}
